# Salin menjadi .env.local (tidak ikut Git). NEXT_PUBLIC_* dimasukkan ke bundel saat build,
# jadi restart 'npm run dev' setelah mengubahnya.

# Alamat backend Laravel. Buka frontend lewat http://localhost:3000 (bukan 127.0.0.1)
# supaya cookie sesi Sanctum terbaca.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
